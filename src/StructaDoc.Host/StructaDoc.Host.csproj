<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StructaDoc.Contracts\StructaDoc.Contracts.csproj" />
    <ProjectReference Include="..\StructaDoc.Application\StructaDoc.Application.csproj" />
    <ProjectReference Include="..\StructaDoc.Adapters\StructaDoc.Adapters.csproj" />
    <ProjectReference Include="..\StructaDoc.Migrations.Sqlite\StructaDoc.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\StructaDoc.Migrations.PostgreSql\StructaDoc.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\StructaDoc.Migrations.MySql\StructaDoc.Migrations.MySql.csproj" />
    <ProjectReference Include="..\StructaDoc.Migrations.MariaDb\StructaDoc.Migrations.MariaDb.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Kept out of the build output on purpose. These are the container image's defaults, and the
      Dockerfile copies the file in itself; letting the SDK publish it with everything else would
      point an ordinary `dotnet run` and every test at the image's /data volume.
    -->
    <Content Remove="appsettings.Container.json" />
    <None Include="appsettings.Container.json" />
  </ItemGroup>

</Project>
