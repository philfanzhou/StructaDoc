{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=./data/structadoc.db",
    "ServerVersion": null,
    "ApplyMigrationsOnStartup": true
  },
  "Worker": {
    "Enabled": true,
    "MaintenanceInterval": "00:00:05",
    "RecoveryBatchSize": 100
  },
  "Documents": {
    "UploadApiEnabled": true,
    "MaxUploadBytes": 104857600
  },
  "Authentication": {
    "DataProtectionKeysPath": "./data/keys",
    "AdministratorSessionLifetime": "08:00:00",
    "LoginPermitLimit": 10,
    "LoginRateLimitWindow": "00:01:00",
    "BootstrapAdministratorEmail": null,
    "BootstrapAdministratorPassword": null,
    "BootstrapAdministratorDisplayName": null
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "./data/storage"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
