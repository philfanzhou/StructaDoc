{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=./data/structadoc.db",
    "ServerVersion": null,
    "ApplyMigrationsOnStartup": true
  },
  "Worker": {
    "Enabled": true,
    "ExecutionEnabled": false,
    "MaintenanceInterval": "00:00:05",
    "RecoveryBatchSize": 100,
    "LeaseDuration": "00:02:00",
    "HeartbeatInterval": "00:00:30",
    "RetryDelay": "00:00:30",
    "MinimumPollDelay": "00:00:01",
    "MaximumPollDelay": "00:00:30"
  },
  "ProviderResults": {
    "MaxArchiveBytes": 536870912,
    "MaxEntryCount": 20000,
    "MaxEntryBytes": 268435456,
    "MaxExpandedBytes": 2147483648,
    "MaxCompressionRatio": 200,
    "MaxEntryPathBytes": 2048,
    "MaxCentralDirectoryBytes": 67108864
  },
  "ProviderResultNormalization": {
    "MaxMarkdownBytes": 67108864,
    "MaxJsonBytes": 67108864,
    "MaxAssetBytes": 268435456,
    "TemporaryPath": "./data/temp/provider-normalization"
  },
  "LibreOffice": {
    "Enabled": true,
    "ExecutablePath": "libreoffice",
    "TemporaryPath": "./data/temp/libreoffice",
    "MaxConcurrency": 1,
    "Timeout": "00:03:00",
    "ResourceInspectionInterval": "00:00:00.250",
    "MaxInputBytes": 104857600,
    "MaxOutputBytes": 209715200,
    "MaxTemporaryBytes": 536870912
  },
  "Documents": {
    "UploadApiEnabled": true,
    "MaxUploadBytes": 104857600
  },
  "Authentication": {
    "DataProtectionKeysPath": "./data/keys",
    "AdministratorSessionLifetime": "08:00:00",
    "LoginPermitLimit": 10,
    "LoginRateLimitWindow": "00:01:00",
    "BootstrapAdministratorUsername": null,
    "BootstrapAdministratorPassword": null,
    "BootstrapAdministratorDisplayName": null
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "./data/storage",
    "ServiceUrl": null,
    "Region": "us-east-1",
    "Bucket": null,
    "Prefix": "structadoc",
    "AccessKey": null,
    "SecretKey": null,
    "ForcePathStyle": true
  },
  "Oidc": {
    "Enabled": false,
    "Authority": null,
    "ClientId": null,
    "ClientSecret": null,
    "RequireHttpsMetadata": true,
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "Scopes": [ "openid", "profile", "email" ],
    "NameClaimType": "name",
    "EmailClaimType": "email",
    "RoleClaimType": "role",
    "AdministratorRole": "structadoc-admin"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
